# EarthLens — Plantilla de configuración local para Docker Compose
# Copiá este archivo a `.env` (ignorado por Git) sólo si necesitás cambiar algún valor.
# Nunca incluyas tokens reales ni credenciales en archivos versionados.

# Puerto local en el host (http://127.0.0.1:${EARTHLENS_PORT})
EARTHLENS_PORT=5000

# Clave de sesión Flask (vacío genera una clave aleatoria segura en desarrollo)
EARTHLENS_SECRET_KEY=

# Modo comercial de Open-Meteo (false = acceso gratuito educativo/no comercial)
EARTHLENS_WEATHER_COMMERCIAL=false
OPEN_METEO_API_KEY=
